# Copy to .env and fill in. Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Fine-grained token with "Pull requests: read & write" and "Contents: read" on the repos you register.
# Not needed for the offline demo (python -m app.demo).
GITHUB_TOKEN=
CORS_ORIGINS=["http://localhost:5173","http://localhost:8088"]

# Optional, paid: the Claude review pass. Ruff and Bandit run for free either way.
LLM_REVIEW_ENABLED=false
ANTHROPIC_API_KEY=

# Optional: an admin account created by the offline demo (python -m app.demo).
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
